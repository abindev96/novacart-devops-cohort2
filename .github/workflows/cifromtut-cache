
name: NovaCart CI

on:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Cache pip dependencies
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ hashFiles('novacart/backend/requirements.txt') }}

      - name: Install dependencies
        run: |
          pip install -r novacart/backend/requirements.txt

      - name: Run tests
        run: pytest novacart/backend/

      - name: Create package
        run: |
          mkdir -p build
          zip -r build/backend.zip novacart/backend/

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: novacart-backend
          path: build/backend.zip
          retention-days: 14
